{
  "schemaVersion": "4.3.0",
  "mode": "SOLO_FDE",
  "requireHumanCheckpoints": true,
  "checkpointStages": [
    "CORE_BOOTSTRAP",
    "SPRINT_SPECS",
    "DEV_IMPLEMENT"
  ],
  "circuitBreaker": {
    "maxRetries": 3,
    "autoAppendLessonsLearned": true
  },
  "roleAssignments": {
    "BA": ["*"],
    "TECH_LEAD": ["*"],
    "DEV": ["*"],
    "SECURITY": ["*"],
    "QA": ["*"],
    "PM": ["*"]
  },
  "addons": {
    "pmtool": {
      "enabled": false,
      "syncOnStages": ["GATE_A_SEAL", "GATE_B_ENG"],
      "dryRun": false
    }
  },
  "pluginsDir": ".ai/plugins"
}

