{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://innovadigits.sa/schemas/company-ecc-baseline.schema.json",
  "title": "InnovaDigits Company-Level Saudi NCA ECC 2:2024 Baseline Schema (v4.2.1)",
  "description": "Organization-wide Saudi NCA ECC 2:2024 governance controls (11 subdomains) managed at the Enterprise CISO / GRC level.",
  "type": "object",
  "required": [
    "schema_version",
    "organization_metadata",
    "subdomains"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "enum": ["4.2.1"]
    },
    "organization_metadata": {
      "type": "object",
      "required": ["organization_name", "ciso_or_compliance_owner", "last_annual_review"],
      "additionalProperties": false,
      "properties": {
        "organization_name": { "type": "string", "minLength": 1 },
        "ciso_or_compliance_owner": { "type": "string", "minLength": 1 },
        "last_annual_review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "subdomains": {
      "type": "object",
      "required": [
        "ECC-1-1",
        "ECC-1-2",
        "ECC-1-3",
        "ECC-1-4",
        "ECC-1-7",
        "ECC-1-9",
        "ECC-1-10",
        "ECC-2-3",
        "ECC-2-4",
        "ECC-2-6",
        "ECC-2-14"
      ],
      "additionalProperties": false,
      "properties": {
        "ECC-1-1": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-1-2": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-1-3": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-1-4": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-1-7": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-1-9": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-1-10": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-2-3": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-2-4": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-2-6": { "$ref": "#/definitions/eccSubdomainEntry" },
        "ECC-2-14": { "$ref": "#/definitions/eccSubdomainEntry" }
      }
    }
  },
  "definitions": {
    "eccSubdomainEntry": {
      "type": "object",
      "required": [
        "title",
        "status",
        "accountable",
        "responsible",
        "evidence_url",
        "review_due"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["Evidenced", "Pending", "Expired"]
        },
        "accountable": {
          "type": "string",
          "enum": ["Executive Sponsor", "Compliance Lead"]
        },
        "responsible": {
          "type": "string",
          "enum": ["Compliance Lead", "Security Reviewer", "HR", "DevOps"]
        },
        "evidence_url": { "type": "string" },
        "review_due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}

