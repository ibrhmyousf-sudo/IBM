{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://innovadigits.sa/schemas/evidence-manifest.schema.json",
  "title": "InnovaDigits Project Security Delivery Evidence Manifest (v4.2.1)",
  "description": "Per-product operational, governance, and time-bound risk-acceptance manifest mapped to Project Security Delivery Checklist V1.1 (SEC-001..SEC-183) and Saudi NCA ECC 2:2024.",
  "type": "object",
  "required": [
    "schema_version",
    "project_metadata",
    "governance_roles",
    "company_baseline_ref",
    "product_controls",
    "risk_acceptances"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "enum": ["4.2.1"]
    },
    "project_metadata": {
      "type": "object",
      "required": [
        "product_name",
        "product_code",
        "environment",
        "release_version",
        "tested_git_tag_or_commit",
        "last_major_change_date",
        "hosting_region",
        "data_classification"
      ],
      "additionalProperties": false,
      "properties": {
        "product_name": { "type": "string", "minLength": 1 },
        "product_code": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "string",
          "enum": ["production", "staging", "development"]
        },
        "release_version": { "type": "string", "minLength": 1 },
        "tested_git_tag_or_commit": { "type": "string", "minLength": 1 },
        "last_major_change_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "hosting_region": { "type": "string", "minLength": 1 },
        "data_classification": {
          "type": "string",
          "enum": ["Public", "Internal", "Confidential", "Restricted", "Top Secret"]
        }
      }
    },
    "governance_roles": {
      "type": "object",
      "required": [
        "executive_sponsor",
        "compliance_lead",
        "security_reviewer",
        "product_owner",
        "engineering_lead",
        "devops_owner"
      ],
      "additionalProperties": false,
      "properties": {
        "executive_sponsor": { "$ref": "#/definitions/roleContact" },
        "compliance_lead": { "$ref": "#/definitions/roleContact" },
        "security_reviewer": { "$ref": "#/definitions/roleContact" },
        "product_owner": { "$ref": "#/definitions/roleContact" },
        "engineering_lead": { "$ref": "#/definitions/roleContact" },
        "devops_owner": { "$ref": "#/definitions/roleContact" }
      }
    },
    "company_baseline_ref": {
      "type": "string",
      "minLength": 1,
      "default": "./company-ecc-baseline.json"
    },
    "product_controls": {
      "type": "object",
      "patternProperties": {
        "^SEC-\\d{3}$": {
          "type": "object",
          "required": [
            "status",
            "evidence_type",
            "evidence_url",
            "verified_at",
            "applies_to_version",
            "owner_role",
            "verified_by",
            "notes"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Passed", "In Progress", "Failed", "Not Started"]
            },
            "evidence_type": {
              "type": "string",
              "enum": ["Test output", "Configuration", "Document", "Approval", "Record"]
            },
            "evidence_url": {
              "type": "string"
            },
            "verified_at": {
              "type": "string"
            },
            "applies_to_version": {
              "type": "string"
            },
            "owner_role": {
              "type": "string",
              "enum": ["Product Owner", "Engineering Lead", "DevOps", "Compliance Lead", "HR"]
            },
            "verified_by": {
              "type": "string",
              "enum": ["Security Reviewer", "Compliance Lead", "Executive Sponsor"]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "risk_acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "finding_id",
          "severity",
          "justification",
          "compensating_controls",
          "risk_owner",
          "approved_by",
          "approved_at",
          "expires_at"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^SEC-\\d{3}$"
          },
          "finding_id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "justification": { "type": "string", "minLength": 5 },
          "compensating_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "risk_owner": { "type": "string", "minLength": 1 },
          "approved_by": { "type": "string", "minLength": 1 },
          "approved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "expires_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  },
  "definitions": {
    "roleContact": {
      "type": "object",
      "required": ["name", "email"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 }
      }
    }
  }
}

