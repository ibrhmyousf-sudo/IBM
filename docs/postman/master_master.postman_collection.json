        {
          "name": "Submit quality review request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "try {",
                  "    var jsonData = pm.response.json();",
                  "    var capturedId = (jsonData && jsonData.data && jsonData.data.id) || (jsonData && jsonData.id);",
                  "    if (capturedId) {",
                  "        pm.collectionVariables.set(\"last_created_id\", capturedId);",
                  "        console.log(\"Captured last_created_id:\", capturedId);",
                  "    }",
                  "} catch (e) {",
                  "    console.error(\"Failed to parse JSON response:\", e);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sample Architecture Review\",\n  \"scope\": \"Sprint S1 Quality Gate\",\n  \"priority\": \"standard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
